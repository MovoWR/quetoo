  <ItemDefinitionGroup>
    <ClCompile>
      <!-- This module's own directory comes first, then the common one. These
           are per project rather than in QuetooFullIncludePath because every
           module has a g_types.h: one global list would make it ambiguous. -->
      <AdditionalIncludeDirectories>..\deps\minizip;..\src\game\race;..\src\game\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- g_client_s and g_entity_s embed the server's view of themselves as an
           anonymous member, which needs this. clang-cl enables it by default; it
           is spelled out so that a toolset change cannot take it away quietly. -->
      <!-- Preserve the same intermediate movement rounding on x86-64 and arm64.
           The narrow suppression covers the intentional override of /fp:precise. -->
      <AdditionalOptions>%(AdditionalOptions) -fms-extensions -Wno-microsoft-anon-tag -Wno-overriding-option /clang:-ffp-contract=off</AdditionalOptions>
      <PreprocessorDefinitions>G_HOOK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>Objectively.lib;SDL3.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>game.def</ModuleDefinitionFile>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <PostBuildEvent>
      <Command>COPY_GAME_MODULE "$(QUETOO_HOME)" "$(Platform)$(Configuration)" "race"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
