{
  "class": "Panel",
  "identifier": "raceAdminRoot",
  "classNames": [
    "menu",
    "adminMenu",
    "masterPage"
  ],
  "contentView": {
    "classNames": [
      "adminContent"
    ],
    "subviews": [
      {
        "class": "StackView",
        "identifier": "adminDocument",
        "classNames": [
          "container",
          "adminBody",
          "esc-page-scroll-content"
        ],
        "subviews": [
          {
            "class": "StackView",
            "classNames": [
              "adminUtilityBar"
            ],
            "subviews": [
              {
                "class": "Label",
                "classNames": [
                  "adminTitle"
                ],
                "text": {
                  "text": "Race administration"
                }
              },
              {
                "class": "TextView",
                "identifier": "adminFilter",
                "classNames": [
                  "adminFilter"
                ],
                "defaultText": "Filter admin controls"
              }
            ]
          },
          {
            "class": "Label",
            "identifier": "adminIntro",
            "classNames": [
              "adminIntro"
            ],
            "text": {
              "text": "Admin actions apply immediately and are logged. The server revalidates your authority and every command before applying changes."
            }
          },
          {
            "class": "StackView",
            "identifier": "adminTabs",
            "classNames": [
              "adminTabs"
            ],
            "subviews": [
              { "class": "Button", "identifier": "adminTabServer", "classNames": [ "adminTab" ], "title": { "text": "Server" } },
              { "class": "Button", "identifier": "adminTabRules", "classNames": [ "adminTab" ], "title": { "text": "Rules" } },
              { "class": "Button", "identifier": "adminTabPlayers", "classNames": [ "adminTab" ], "title": { "text": "Players" } },
              { "class": "Button", "identifier": "adminTabSession", "classNames": [ "adminTab" ], "title": { "text": "Session" } },
              { "class": "Button", "identifier": "adminTabAdvanced", "classNames": [ "adminTab" ], "title": { "text": "Advanced" } },
              { "class": "Button", "identifier": "adminTabWeapons", "classNames": [ "adminTab" ], "title": { "text": "Weapons" } }
            ]
          },
          { "class": "View", "identifier": "adminTabsRule", "classNames": [ "adminTabsRule" ] },
          {
            "class": "StackView",
            "identifier": "adminColumns",
            "classNames": [
              "columns",
              "container",
              "adminColumns"
            ]
          },
          {
            "class": "StackView",
            "identifier": "adminWideSections",
            "classNames": [
              "container",
              "adminWideSections"
            ]
          },
          {
            "class": "StackView",
            "identifier": "adminWeaponLabHost",
            "classNames": [
              "adminWeaponLabHost"
            ]
          },
          {
            "class": "StackView",
            "identifier": "adminResponse",
            "classNames": [
              "adminResponse"
            ],
            "subviews": [
              {
                "class": "Label",
                "identifier": "adminResponseCommand",
                "classNames": [
                  "adminResponseCommand"
                ],
                "text": {}
              },
              {
                "class": "Label",
                "identifier": "adminResponseReply",
                "classNames": [
                  "adminResponseReply"
                ],
                "text": { "lineWrap": true }
              }
            ]
          },
          {
            "class": "Label",
            "identifier": "adminEmptyState",
            "classNames": [
              "adminEmptyState"
            ],
            "text": {
              "text": "Nothing matches that filter."
            }
          },
          {
            "class": "StackView",
            "identifier": "adminSignedOut",
            "classNames": [
              "adminSignedOut"
            ],
            "subviews": [
              {
                "class": "Label",
                "classNames": [
                  "adminSignedOutTitle"
                ],
                "text": {
                  "text": "Admin route hidden"
                }
              },
              {
                "class": "Label",
                "classNames": [
                  "adminSignedOutCopy"
                ],
                "text": {
                  "lineWrap": true,
                  "text": "No authenticated Race administrator session on this connection, so STAT_RACE_ADMIN_CAPABILITIES publishes 0x00 and the menu dismisses this panel."
                }
              },
              {
                "class": "Label",
                "classNames": [
                  "adminSignedOutCopy"
                ],
                "text": {
                  "lineWrap": true,
                  "text": "In the client console, set the local one-use password with set radmin_password <password>, then use radmin <account>. The password is not sent to the server."
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "accessoryView": {
    "identifier": "adminFooter",
    "hidden": false,
    "classNames": [
      "adminFooter"
    ],
    "subviews": [
      {
        "class": "StackView",
        "classNames": [
          "adminFooterStatus"
        ],
        "subviews": [
          {
            "class": "Label",
            "identifier": "adminHint",
            "classNames": [
              "adminHint"
            ],
            "text": {}
          },
          {
            "class": "Label",
            "identifier": "adminProvenance",
            "classNames": [
              "adminProvenance"
            ],
            "text": {}
          }
        ]
      }
    ]
  }
}
