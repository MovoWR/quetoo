{
  "class": "StackView",
  "identifier": "quickSettingsDrawer",
  "subviews": [
    {
      "class": "StackView",
      "identifier": "quickHeader",
      "subviews": [
        { "class": "Label", "identifier": "quickTitle", "text": { "text": "Quick settings" } },
        { "class": "Button", "identifier": "quickClose", "title": { "text": "Close" } }
      ]
    },
    {
      "class": "StackView",
      "identifier": "quickHintRow",
      "subviews": [
        { "class": "Label", "identifier": "quickHint", "text": { "text": "Changes apply immediately." } },
        { "class": "Label", "identifier": "quickEscHint", "text": { "text": "Esc closes" } }
      ]
    },
    {
      "class": "StackView",
      "identifier": "quickSettingsContent",
      "subviews": [
        {
          "class": "StackView",
          "classNames": [ "quickSection" ],
          "subviews": [
            {
              "class": "StackView",
              "classNames": [ "quickSectionHeader" ],
              "subviews": [
                { "class": "Label", "classNames": [ "sectionEyebrow" ], "text": { "text": "Aim" } },
                { "class": "Label", "identifier": "quickAimStatus", "classNames": [ "quickSectionStatus" ], "text": { "text": "m_sensitivity · cg_fov" } }
              ]
            },
            { "class": "View", "classNames": [ "sectionRule" ] }
          ]
        },
        {
          "class": "Input",
          "label": { "text": { "text": "Mouse sensitivity" } },
          "control": { "class": "RaceSlider", "identifier": "quickSensitivity", "var": "m_sensitivity", "min": 0.125, "max": 6.0, "step": 0.125 }
        },
        {
          "class": "Input",
          "label": { "text": { "text": "Field of view" } },
          "control": { "class": "RaceSlider", "identifier": "quickFov", "var": "cg_fov", "min": 90, "max": 160, "step": 1 }
        },
        {
          "class": "StackView",
          "classNames": [ "quickSection", "quickSectionSpaced" ],
          "subviews": [
            {
              "class": "StackView",
              "classNames": [ "quickSectionHeader" ],
              "subviews": [
                { "class": "Label", "classNames": [ "sectionEyebrow" ], "text": { "text": "HUD helpers" } },
                { "class": "Label", "identifier": "quickHelperStatus", "classNames": [ "quickSectionStatus" ], "text": { "text": "0 of 3 on" } }
              ]
            },
            { "class": "View", "classNames": [ "sectionRule" ] }
          ]
        },
        {
          "class": "Input",
          "label": { "text": { "text": "Strafe helper" } },
          "control": { "class": "CvarCheckbox", "identifier": "quickStrafeHelper", "var": "cg_race_strafe_helper_draw" }
        },
        {
          "class": "Input",
          "label": { "text": { "text": "UPS meter" } },
          "control": { "class": "CvarCheckbox", "identifier": "quickUps", "var": "cg_race_strafe_helper_ups" }
        },
        {
          "class": "Input",
          "label": { "text": { "text": "Input display" } },
          "control": { "class": "CvarCheckbox", "identifier": "quickInputViewer", "var": "cg_input_viewer" }
        }
      ]
    },
    { "class": "View", "identifier": "quickFooterRule", "classNames": [ "sectionRule" ] },
    {
      "class": "StackView",
      "identifier": "quickFooter",
      "subviews": [
        { "class": "Button", "identifier": "quickControls", "title": { "text": "All controls" } },
        { "class": "Button", "identifier": "quickSettings", "title": { "text": "All settings" } }
      ]
    }
  ]
}
